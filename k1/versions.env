# Pinned inputs for the reproducible KICKPI K1A DietPi image.
# Every source is fetched by tag AND verified against the commit id below.

# Docker base image (debian:trixie-slim, 2026-11-16)
BASE_IMAGE="debian@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2"

# Linux 6.18 LTS
LINUX_VERSION="6.18.63"
LINUX_URL="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-${LINUX_VERSION}.tar.xz"
LINUX_LOCALVERSION="-k1"
LINUX_SHA256="81764a545072d160748beff4d9de2e7d95aa9f16e8261110288f067a2cc61d71"

# Mainline U-Boot
UBOOT_TAG="v2026.10"
UBOOT_COMMIT="5508406582f6f7120dce0c4b3059819a41788db2"
UBOOT_URL="https://github.com/u-boot/u-boot.git"

# Mainline TF-A (BL31)
TFA_TAG="v2.15.0"
TFA_COMMIT="da738d5eae93af342fdc4995dd3c05acb4c9d757"
TFA_URL="https://github.com/ARM-software/arm-trusted-firmware.git"

# Rockchip rkbin (DDR init blob only)
RKBIN_COMMIT="3e288fe814e059dd06833495f845cab04ac20a5c"
RKBIN_URL="https://github.com/rockchip-linux/rkbin.git"

# Debian release for the rootfs
DEBIAN_SUITE="trixie"

# linux-firmware: only the RTL8822CS Wi-Fi/BT blobs, each pinned by sha256
FIRMWARE_TAG="20261019"
FIRMWARE_URL="https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git/plain"
FIRMWARE_FILES="
rtw88/rtw8822c_fw.bin=3deecb31210986d98cdbfb000391e08d602a6eee4ffc883969faa2b907ab03ba
rtw88/rtw8822c_wow_fw.bin=6717fc6ff426a74571ac4f04cd9698fb2f356012c05c58aa64cf21ceb6b958a2
rtl_bt/rtl8822cs_fw.bin=42db5218c54b0638e1bafdbc7d0986172288e55a9e1c879080d41206bb87dfa2
rtl_bt/rtl8822cs_config.bin=dbdc0a455f628337509afbdb6e1fb42e1622e3e876fc2aa962cc1b754709131c
"

# DietPi fork branch used by dietpi-build (installer + scripts are fetched from GitHub)
DIETPI_OWNER="stulluk"
DIETPI_BRANCH="kickpi-k1"
