# KICKPI K1A U-Boot fragment on top of generic-rk3568_defconfig.
# Fast boot, Rockusb for automatic flashing, stable MACs from the CPU id.
# 1 s so rk-burn-tool can always stop autoboot with Ctrl-C (0 was not reliable)
CONFIG_BOOTDELAY=1
CONFIG_MISC_INIT_R=y
CONFIG_ROCKCHIP_OTP=y
CONFIG_HASH=y
CONFIG_SHA256=y
# CONFIG_NO_NET is not set
CONFIG_NET=y
CONFIG_CMD_ROCKUSB=y
CONFIG_USB_FUNCTION_ROCKUSB=y
CONFIG_CMD_USB_MASS_STORAGE=y
CONFIG_BOOTSTD_DEFAULTS=y
CONFIG_CMD_BOOTEFI=n
CONFIG_EFI_LOADER=n
